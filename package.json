{
  "name": "@nandoblanco/opencode-local-search",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Local-first, zero-token interactive TUI popup plugin to search past OpenCode sessions with multi-term AND, regex, fuzzy matching, and inline filters (role, date, file, tool, project scope).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "bin": {
    "opencode-local-search": "cli.js"
  },
  "files": [
    "cli.js",
    "src/*.ts",
    "src/*.tsx",
    "src/*.css",
    "dist/*.cjs",
    "assets/screenshot.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "node --no-warnings --experimental-strip-types --test test/search.test.ts",
    "test:browser": "node test/search-shortcut.mjs"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "local-first",
    "zero-token",
    "session-search",
    "history-search",
    "tui",
    "sqlite",
    "fuzzy-search"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=2.0.0",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "14.0.5",
    "minimatch": "11.0.8"
  },
  "author": "nandoblanco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandoblanco/opencode-local-search.git"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "@opencode/plugin": "^2.2.4",
    "@opencode/theme": "^2.2.4",
    "solid-js": "^1.9.18",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
